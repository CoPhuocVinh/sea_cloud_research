    <!-- sea-cloud: dựng sẵn bộ đếm facet search_text_cloud (un-invert) cho searcher mới trước khi nhận truy vấn -->
    <listener event="newSearcher" class="solr.QuerySenderListener">
      <arr name="queries">
        <lst><str name="q">*:*</str><str name="rows">0</str><str name="facet">true</str>
             <str name="facet.field">search_text_cloud</str><str name="facet.limit">1</str></lst>
      </arr>
    </listener>
    <listener event="firstSearcher" class="solr.QuerySenderListener">
      <arr name="queries">
        <lst><str name="q">*:*</str><str name="rows">0</str><str name="facet">true</str>
             <str name="facet.field">search_text_cloud</str><str name="facet.limit">1</str></lst>
      </arr>
    </listener>
